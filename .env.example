# Variables de entorno del servicio (Railway → Variables). NO commitear el .env real.

# Postgres (misma base de Railway que usa el dashboard actual)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PUERTO/railway
# PGSSL=true   # solo si tu Postgres exige SSL

# GoHighLevel (Private Integration Token de la subcuenta + Location ID)
GHL_PIT=pit-xxxxxxxx
LOCATION_ID=bzRd2deoIdOClJZ44bv5
# BOT_STATUS_FIELD_ID=M2ONiagYfBbAJrC9jhgO   # id del custom field "Bot Status"
# HANDOFF_TAG=handoff

# WhatsApp Cloud API (para enviar; recibir sigue en tu flujo de Meta)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=302766349596365

# Supabase — LOGIN / panel de usuarios (auth)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...           # público (valida tokens, va al frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secreto (crear/administrar usuarios)

# Supabase — CONTACTOS (espejo del handoff: bot_active para la RPC/n8n).
# SOLO si el proyecto de contactos es DISTINTO al del login. Si es el mismo,
# omite estas dos y usará SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY de arriba.
# SUPABASE_CONTACTS_URL=https://bewpkmqcnzu....supabase.co
# SUPABASE_CONTACTS_KEY=eyJ...       # service_role del proyecto de contactos

# URL pública del servicio (para que WhatsApp pueda leer /api/media al enviar adjuntos)
PUBLIC_URL=https://tu-dashboard.up.railway.app

# Opcionales
# PORT=8080
# JSON_LIMIT=60mb

# CORS. La app nativa (capacitor://localhost, https://localhost) y localhost
# están permitidos siempre. La versión web (PWA) se acepta desde cualquier
# subdominio propio por https; solo hay que tocar esto si cambia el dominio.
# CORS_DOMAIN=neboaiconsulting.com
# CORS_EXTRA=https://otro-origen.com,https://y-otro.com
